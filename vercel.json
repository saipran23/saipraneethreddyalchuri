{
  "rewrites": [
    {
      "source": "/((?!assets/|profile/|projects/|skills/|favicon.svg).*)",
      "destination": "/index.html"
    },
    { "source": "/projects/:slug", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
